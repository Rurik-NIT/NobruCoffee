# ─────────────────────────────────────────────────────────────────────────────
# Nobru Coffee — variáveis de ambiente
# Copie para `.env` e ajuste. NUNCA comite o `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Banco de dados PostgreSQL (obrigatório).
# Local, via `pnpm db:up` (docker compose):
DATABASE_URL="postgresql://nobru:nobru@localhost:5432/nobru?schema=public"

# Segredo usado para assinar/derivar tokens de sessão (obrigatório).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio-de-48-bytes"

# URL pública da aplicação — usada em cookies, PWA e links de recibo.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Fuso horário de operação da loja (usado em fechamento de caixa e relatórios).
STORE_TIMEZONE="America/Sao_Paulo"

# Duração da sessão em dias (opcional, padrão 7).
SESSION_TTL_DAYS="7"

# Ambiente: development | production
NODE_ENV="development"
