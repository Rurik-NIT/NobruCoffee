{
  // Terminal › Executar Tarefa…  (ou Ctrl+Shift+P → "Run Task")
  //
  // No dia a dia é só "Rodar": ele prepara o banco se precisar e sobe o
  // servidor. As outras tarefas existem para quando algo sai do lugar.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rodar",
      "detail": "Prepara o banco se precisar e sobe em http://localhost:3000. É a tarefa padrão (Ctrl+Shift+B).",
      "type": "shell",
      "command": "bun run dev",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "next",
        "pattern": { "regexp": "^(.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(banco|Starting|Compiling|compiling).*",
          "endsPattern": ".*(Ready in|Local:\\s+http).*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Criar o usuário do banco no PostgreSQL",
      "detail": "Roda uma vez só. O psql pede a senha do postgres aqui no terminal. O banco em si o 'Rodar' cria depois.",
      // type "process" e não "shell": o SQL vai como argumento literal para o
      // psql. Passar por `powershell -Command` fazia a camada de shell comer as
      // aspas e o psql recebia CREATE, ROLE, nobru… como argumentos soltos.
      "type": "process",
      "command": "${config:nobru.psql}",
      "args": [
        "-U",
        "postgres",
        "-c",
        // Idempotente: rodar de novo não dá erro de papel já existente.
        "DO $$ BEGIN IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'nobru') THEN CREATE ROLE nobru LOGIN PASSWORD 'nobru' CREATEDB; END IF; END $$;"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Preparar o banco (sem subir o servidor)",
      "detail": "Cria o banco se faltar, aplica o schema e popula. É o mesmo passo que o 'Rodar' faz sozinho.",
      "type": "shell",
      "command": "bun run banco:preparar",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Prisma Studio (ver as tabelas)",
      "detail": "Navegador de tabelas em http://localhost:5555",
      "type": "shell",
      "command": "bun run db:studio",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Recomeçar a base do zero",
      "detail": "Apaga e recria tudo, inclusive os 45 dias de histórico. Use quando o banco ficar num estado estranho.",
      "type": "shell",
      "command": "bun run db:push --force-reset; if ($?) { bun run db:seed }",
      "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Conferir tudo (tipos, lint, rotas)",
      "detail": "O que o CI roda. Não precisa de banco.",
      "type": "shell",
      "command": "bun run typecheck; bun run lint; bun run verificar:rotas",
      "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
