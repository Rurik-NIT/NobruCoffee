{
  // F5 sobe o servidor com depurador e abre o navegador já conectado.
  // Pontos de interrupção funcionam nos dois lados: Server Actions e componentes.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nobru — servidor (Next.js)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://[^\\s]+)",
        "uriFormat": "%s",
        "action": "debugWithEdge"
      }
    },
    {
      "name": "Nobru — só o navegador",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
